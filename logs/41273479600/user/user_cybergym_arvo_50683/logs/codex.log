{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/sim.py <<'PY'\nimport struct\np=open('/workspace/poc','rb').read()\nc=p[41427:41795]\n\ndef read_tag(b,left):\n    if left<2:return None\n    p=0\n    tag=b[0];cla=(tag&0xc0)|(tag&0x20);tag&=0x1f;p=1;left-=1\n    if tag==0x1f:\n        n=7\n        while True:\n            if left==0 or n==0:return None\n            tag<<=8;tag|=b[p];p+=1;left-=1;n-=1\n            if not tag&0x80:break\n    if left==0:return None\n    l=b[p];p+=1;left-=1\n    if l&0x80:\n        n=l&0x7f\n        if n>4 or n>left:return None\n        a=0\n        for _ in range(n):\n            a=(a<<8)|b[p];p+=1;left-=1\n        l=a\n    return p,l\ndef find(b,left,want):\n    p=0\n    while left>=2:\n        st=read_tag(b[p:],left)\n        if not st:return None\n        hp,l=st\n        tag=b[p]\n        # simplistic (not high)\n        if tag==want:\n            return p+hp,l\n        p+=hp+l;left-=hp+l\n    return None\nprint('data len',len(c))\nr=find(c,len(c),0x30)\nprint('outer',r)\nif r:\n    st=r[0]; body=c[st[0]:st[0]+st[1]]; print('body',st[1],body.hex())\n    r2=find(body,st[1],2)\n    print('inner',r2)\n    if r2:\n        tagp,taglen=r2; print('tagp in body',tagp,'taglen',taglen,'tag first',body[tagp],body[tagp:tagp+taglen].hex())\nPY\npython3 /tmp/sim.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
